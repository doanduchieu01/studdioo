{
  "manifest_version": 3,
  "name": "Stuđiô AI Companion",
  "short_name": "Stuđiô AI",
  "version": "1.0.0",
  "description": "Tiện ích đồng hành học tập, nhịp sinh học và tập trung Calm Tech cho sinh viên",
  "permissions": [
    "activeTab",
    "alarms",
    "notifications",
    "sidePanel",
    "storage",
    "tabs",
    "scripting",
    "idle",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Mở Stuđiô AI Companion",
    "default_icon": {
      "128": "icons/logo.png"
    }
  },
  "externally_connectable": {
    "matches": [
      "https://exe-studio.onrender.com/*",
      "http://localhost:5173/*",
      "http://127.0.0.1:5173/*",
      "http://localhost:8000/*",
      "http://127.0.0.1:8000/*"
    ]
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "omnibar": {
    "keyword": "studi"
  },
  "commands": {
    "toggle-taskpad": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Alt+S"
      },
      "description": "Bật/Thu gọn TaskPad nổi trên mọi trang web"
    },
    "quick-capture": {
      "suggested_key": {
        "default": "Alt+N",
        "mac": "Alt+N"
      },
      "description": "Thu thập nhanh trang web hiện tại vào Stuđiô"
    }
  },
  "key": "",
  "icons": {
    "128": "icons/logo.png"
  }
}
